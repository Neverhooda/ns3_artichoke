+
+void
+RoutingProtocol::RepairOwnRoutes (std::map<Ipv4Address, uint32_t> const & unreachable)
+{
+  if (!m_fastRepair)
+    return;
+  for (std::map<Ipv4Address, uint32_t>::const_iterator i = unreachable.begin ();
+       i != unreachable.end (); ++i)
+    {
+      std::map<Ipv4Address, Time>::const_iterator own = m_ownDestinations.find (i->first);
+      if (own == m_ownDestinations.end () || Simulator::Now () - own->second > m_deletePeriod)
+        continue;
+      Simulator::Schedule (MilliSeconds (m_uniformRandomVariable->GetInteger (0, 50)),
+                           &RoutingProtocol::StartRepair, this, i->first);
+    }
+}
+
+void
+RoutingProtocol::StartRepair (Ipv4Address dst)
+{
+  RoutingTableEntry rt;
+  if (m_routingTable.LookupValidRoute (dst, rt))
+    return;
+  if (m_addressReqTimer.find (dst) != m_addressReqTimer.end ()
+      && m_addressReqTimer[dst].IsRunning ())
+    return;
+  NS_LOG_LOGIC ("Fast repair: rediscover route to " << dst);
+  SendRequest (dst);
 }
 
